# Basic binds
super + Return
    default-terminal
super + d
    dmenu-simple
super + p
    dmenu-simple
shift + super + d
    dmenu-full
shift + super + p
    dmenu-full
shift + super + Escape
    dmenu-power
shift + super + w
    rofi -show window
shift + super + s
    dmenu-surfraw

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# lockscreen
shift + super + x
    i3lock-fancy

XF86ScreenSaver
    i3lock-fancy

# screen change
XF86Display
    dmenu-screen

# Multimedia

#TODO add microphone mute
XF86AudioMicMute
    pulsemixer --id source-1 --toggle-mute

# mixer super + m
super + shift + control + m
	pavucontrol

super + shift + m
	open_neomutt

#; super + plus
XF86AudioRaiseVolume
	pamixer --allow-boost -i 5
#; super + shift + plus
shift + XF86AudioRaiseVolume
	pamixer --allow-boost -i 15

#; super + minus
XF86AudioLowerVolume
	pamixer --allow-boost -d 5
#; super + shift + minus
shift + XF86AudioLowerVolume
	pamixer --allow-boost -d 15

#; super + shift + m
XF86AudioMute
	pamixer --allow-boost -t

XF86AudioPlay
	playerctl play-pause

XF86Audio{Prev,Next}
	playerctl {previous,next}

