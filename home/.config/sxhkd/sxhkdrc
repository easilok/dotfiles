# Basic binds
super + Return
    default_terminal
super + d
    dmenu-simple
super + p
    dmenu-simple
shift + super + d
    dmenu-full
shift + super + p
    dmenu-full
shift + super + Escape
    dmenu-power
shift + super + h
    dmenu-power
shift + super + w
    rofi -show window
shift + super + s
    dmenu-surfraw
control + super + s
    dmenu-surfraw google
super + b
    dmenu-bookmarks
super + e
    pcmanfm
control + alt + h
  $HOME/.config/sxhkd/scripts/show_clipboard.sh

Print
  $HOME/.config/sxhkd/scripts/print-screen.sh

shift + Print
  flameshot launcher

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# lockscreen
shift + super + x
  $HOME/.config/sxhkd/scripts/lock_screen.sh

XF86ScreenSaver
  $HOME/.config/sxhkd/scripts/lock_screen.sh

# screen change
XF86Display
    dmenu-screen

# Multimedia

#TODO add microphone mute
XF86AudioMicMute
    pactl set-source-mute $(pactl get-default-source) toggle

# mixer super + m
super + shift + control + m
	pavucontrol

super + shift + m
	open_neomutt

#; super + plus
XF86AudioRaiseVolume
    pactl set-sink-volume $(pactl get-default-sink) +5%
#; super + shift + plus
shift + XF86AudioRaiseVolume
    pactl set-sink-volume $(pactl get-default-sink) +15%

#; super + minus
XF86AudioLowerVolume
    pactl set-sink-volume $(pactl get-default-sink) -5%
#; super + shift + minus
shift + XF86AudioLowerVolume
    pactl set-sink-volume $(pactl get-default-sink) -15%

#; super + shift + m
XF86AudioMute
    pactl set-sink-mute $(pactl get-default-sink) toggle

XF86AudioPlay
	playerctl play-pause

XF86Audio{Prev,Next}
	playerctl {previous,next}

super + {F12, F10, F11}
	playerctl {play-pause,previous,next}

super + F7
    $HOME/.screenlayout/internal_monitor

super + shift + F7
    $HOME/.config/sxhkd/scripts/change_monitors.sh

XF86MonBrightnessDown
    sudo brightnessctl set 10%-

XF86MonBrightnessUp
    sudo brightnessctl set 10%+
