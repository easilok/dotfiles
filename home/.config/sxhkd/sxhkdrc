# Basic binds
super + Return
    default_terminal
super + d
    dmenu-simple
super + p
    dmenu-simple
shift + super + d
    dmenu-full
shift + super + p
    dmenu-full
shift + super + Escape
    dmenu-power
shift + super + h
    dmenu-power
shift + super + w
    rofi -show window
shift + super + s
    dmenu-surfraw
control + super + s
    dmenu-surfraw google
super + b
    dmenu-bookmarks
super + e
    pcmanfm
control + alt + h
  $HOME/.config/sxhkd/scripts/show_clipboard.sh

Print
  $HOME/.config/sxhkd/scripts/print-screen.sh

shift + Print
  flameshot launcher

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# lockscreen
shift + super + x
  $HOME/.config/sxhkd/scripts/lock_screen.sh

XF86ScreenSaver
  $HOME/.config/sxhkd/scripts/lock_screen.sh

# screen change
XF86Display
    dmenu-screen

# Multimedia

#TODO add microphone mute
XF86AudioMicMute
        wpctl set-mute @DEFAULT_SINK@ toggle

# mixer super + m
super + shift + control + m
	pavucontrol

super + shift + m
	open_neomutt

#; super + plus
XF86AudioRaiseVolume
        wpctl set-volume @DEFAULT_SINK@ 5%+
#; super + shift + plus
shift + XF86AudioRaiseVolume
        wpctl set-volume @DEFAULT_SINK@ 15%+

#; super + minus
XF86AudioLowerVolume
        wpctl set-volume @DEFAULT_SINK@ 5%-
#; super + shift + minus
shift + XF86AudioLowerVolume
        wpctl set-volume @DEFAULT_SINK@ 15%-

#; super + shift + m
XF86AudioMute
	wpctl set-mute @DEFAULT_SOURCE@ toggle

XF86AudioPlay
	playerctl play-pause

XF86Audio{Prev,Next}
	playerctl {previous,next}

super + {F12, F10, F11}
	playerctl {play-pause,previous,next}

super + F7
    $HOME/.screenlayout/internal_monitor

super + shift + F7
    $HOME/.config/sxhkd/scripts/change_monitors.sh

XF86MonBrightnessDown
    sudo brightnessctl set 5%-

XF86MonBrightnessUp
    sudo brightnessctl set 5%+

shift + alt + F6
    brightnessctl set 5%-

shift + alt + F7
    brightnessctl set 5%+
