vs() {
    if [ -f 'Session.vim' ]; then
        vim -S Session.vim
    else
        session_files=$(find . -type f -name '*.vim')
        session_count=$(echo "$session_files" | wc -l)
        if [ "$session_count" -gt 0 ]; then
            vim -S $(echo "$session_files" | fzf)
        else
            vim
        fi
    fi
}
