#
## # ex - archive extractor
## # usage: ex <file>
ex() 
{
 if [ -f $1 ] ; then
		case $1 in
			*.tar.bz2)   tar xjf $1   ;;
			*.tar.gz)    tar xzf $1   ;;
			*.bz2)       bunzip2 $1   ;;
			*.rar)       unrar x $1     ;;
			*.gz)        gunzip $1    ;;
			*.tar)       tar xf $1    ;;
			*.tbz2)      tar xjf $1   ;;
			*.tgz)       tar xzf $1   ;;
			*.zip)       unzip $1     ;;
			*.Z)         uncompress $1;;
			*.7z)        7z x $1      ;;
			*)           echo "'$1' cannot be extracted via ex()" ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}

alias config='cd ~/.config'
alias dotfiles='cd ~/git/dotfiles'

# Changing "ls" to "exa"
if [ -f $(which exa) ]; then 
	alias ls='exa -l --header --color=always --git --group-directories-first' # my preferred listing
	alias la='exa -a --color=always --group-directories-first'  # all files and dirs
	alias ll='exa -al --header --color=always --git --group-directories-first'  # long format
	alias lt='exa -aT --color=always --group-directories-first' # tree listing
fi

if [ -f $(which nvim) ]; then 
	alias vim=nvim
fi

