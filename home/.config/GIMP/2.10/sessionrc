# GIMP sessionrc
# 
# This file takes session-specific info (that is info, you want to keep
# between two GIMP sessions).  You are not supposed to edit it manually, but
# of course you can do.  The sessionrc will be entirely rewritten every time
# you quit GIMP.  If this file isn't found, defaults are used.

(session-info "toplevel"
    (factory-entry "gimp-empty-image-window")
    (position 200 100)
    (size 640 480))
(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    (position 1 19)
    (size 1594 876)
    (open-on-exit)
    (aux-info
        (left-docks-width "184")
        (right-docks-width "273")
        (maximized "no"))
    (gimp-toolbox
        (side left)
        (book
            (current-page 1)
            (dockable "gimp-device-status"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-undo-history"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-image-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))))
    (gimp-dock
        (side right)
        (book
            (current-page 0)
            (dockable "gimp-layer-list"
                (tab-style icon-name)
                (preview-size 64)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-brush-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-pattern-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-font-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-document-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-histogram-editor"
                (tab-style automatic)
                (aux-info
                    (histogram-scale "logarithmic")))
            (dockable "gimp-navigation-view"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 526)
            (current-page 0)
            (dockable "gimp-tool-options"
                (tab-style icon-name)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-channel-list"
                (tab-style automatic)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-vectors-list"
                (tab-style automatic)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true"))))))
(session-info "toplevel"
    (factory-entry "gimp-file-open-dialog")
    (position 0 19)
    (size 683 726))
(session-info "toplevel"
    (factory-entry "gimp-file-save-dialog")
    (position 495 41)
    (size 685 728))
(session-info "toplevel"
    (factory-entry "gimp-file-export-dialog")
    (position 441 19)
    (size 683 726))
(session-info "toplevel"
    (factory-entry "gimp-curves-tool-dialog")
    (position 167 11)
    (size 368 570))
(session-info "toplevel"
    (factory-entry "gimp-levels-tool-dialog")
    (position 842 160)
    (size 618 738))
(session-info "toplevel"
    (factory-entry "gimp-preferences-dialog")
    (position 195 92)
    (size 733 647))
(session-info "toplevel"
    (factory-entry "gimp-image-new-dialog")
    (position 0 0))
(session-info "toplevel"
    (factory-entry "gimp-operation-tool-dialog")
    (position 142 93))
(session-info "toplevel"
    (factory-entry "gimp-toolbox-color-dialog")
    (position 802 21))

(hide-docks no)
(single-window-mode yes)
(show-tabs yes)
(tabs-position 0)
(last-tip-shown 0)

# end of sessionrc
