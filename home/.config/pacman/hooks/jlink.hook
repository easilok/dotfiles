# /etc/pacman.d/hooks/<file>.hook
[Trigger]
Operation = Upgrade
Operation = Install
Type = Package
Target = jlink-software-and-documentation

[Action]
Description = Update JLink NIBBLE devices
# Depends is optional if this should depend on another package
# Depends =
When = PostTransaction
Exec = /home/luis/local_scripts/hook_jlink_files
