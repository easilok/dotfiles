# vim: filetype=muttrc

source ~/.config/neomutt/settings
source ~/.config/neomutt/colors
source ~/.config/neomutt/mappings
source ~/.config/neomutt/alias

## Acounts Shortcuts
macro index,pager <f3> '<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/personal<enter><change-folder>!<enter>'
macro index,pager <f4> '<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/professional<enter><change-folder>!<enter>'
macro index,pager <f5> '<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/xyz<enter><change-folder>!<enter>'
# macro index,pager <f6> '<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/luispereira<enter><change-folder>!<enter>'
macro index,pager <f6> '<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/isep<enter><change-folder>!<enter>'

# Accounts
source ~/.config/neomutt/accounts/personal
