#!/usr/bin/env bash

COINS=(
  "DOGE 21.22913"
  "BAT 4.81799"
  "REN 6.79109"
  "EOS 1.4642"
  "BTC 0.00001"
)

for coin in "${COINS[@]}"; do
    read coin qtd <<< "$coin"  # uses default whitespace IFS
    echo $coin": "$(curl -s "https://eur.rate.sx/$qtd$coin")
done

