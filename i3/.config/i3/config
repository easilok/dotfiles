# movin floating windows
mode "moveit" {
    bindsym Up move up 20px
    bindsym Left move left 20px
    bindsym Down move down 20px
    bindsym Right move right 20px
    bindsym Mod4+m mode "default"

  #exit system mode: "Enter" or "Escape"
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+m focus floating; mode "moveit"

# windows decorations
#new_window pixel 2
default_border pixel 2
hide_edge_borders smart
focus_follows_mouse no
focus_wrapping workspace

# Switch to previous workspace when selecting current one
# workspace_auto_back_and_forth yes
bindsym $mod+z workspace back_and_forth
bindsym $mod+Shift+z move container to workspace back_and_forth; workspace back_and_forth

exec_always --no-startup-id "$HOME/.local/bin/i3-autostart"

# finds out, if available)
bar {
    position top
    tray_output primary
    status_command i3status
    # status_command i3blocks
    # Remove workspace change on scroll
    bindsym button4 nop
    bindsym button5 nop
}

