# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
    colors = true
    interval = 5
    # color_good = "#FFFFFF"
}

order += "read_file outlook"
# order += "read_file spotify"
order += "battery all"
order += "volume master"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "disk /home"
order += "cpu_temperature 0"
# order += "wireless _first_"
order += "tztime local"

wireless _first_ {
    format_up = " WiFi: (%quality at %essid) "
    format_down = " WiFi: down "
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = "⚡ CHR"
    status_bat = "🔋 BAT"
    status_unk = "? UNK"
    status_full = "☻ FULL"
    # path = "/sys/class/power_supply/BAT%d/uevent"
    threshold_type = "percentage"
    low_threshold = 20
}

tztime local {
    format = " %d/%m (W%V) - %H:%M |"
}

load {
    format = " Load: %1min "
}

disk "/" {
    format = " /: %percentage_used "
    threshold_type = percentage_free
    low_threshold = 15
}

disk "/home" {
    format = " /h: %percentage_used "
    threshold_type = percentage_free
    low_threshold = 15
}

volume master {
    format = " ♪: %volume "
    format_muted = " ♪: muted (%volume) "
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

cpu_usage {
    format = " P: %usage "
    max_threshold = 80
    degraded_threshold = 50
}

cpu_temperature 0 {
    format = "T: %degrees °C"
    path = "/sys/class/thermal/thermal_zone0/temp"
    max_threshold = 75
}

memory {
    format = "M: %percentage_used"
    threshold_degraded = "20%"
    threshold_critical = "10%"
        #format_degraded = "M: %free"
}

read_file spotify {
    format = "%content"
    path = "/tmp/spotify_status"
}

read_file outlook {
    format = "%content"
    path = "/tmp/outlookEvents/next_event"
    color_good = "#FFFFFF"
}
