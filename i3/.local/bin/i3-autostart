#!/usr/bin/env bash
run() {
	if [ ! $(pgrep -f $1) ]
  then
    $@&
  fi
}

# if [ $(pgrep -f "dwm_autorun") ] ; then
# 	echo "Already Started"
# 	exit
# fi

sleep 5
numlockx &
xmodmap -e "clear lock" &
xmodmap -e "keycode 66 = Escape NoSymbol Escape" &
setxkbmap -option caps:escape &
setxkbmap -layout pt &
xsetroot -cursor_name left_ptr &
if [ -f "$(which i3lock-clock-image)" ]; then 
  xss-lock -- i3lock-clock-image &
elif [ -f "$(which i3lock-clock)" ]; then 
  xss-lock -- i3lock-clock &
elif [ -f "$(which i3lock-fancy)" ]; then 
  xss-lock -- i3lock-fancy -p &
else
  xss-lock -- i3lock &
fi
wmname compiz

# base apps
run picom
run nm-applet
run ~/scripts/set_wallpaper
run greenclip daemon
run xsettingsd
run sxhkd
run nextcloud
# If there's a personal Xmodmap setup, use it
[[ -f "$HOME/.Xmodmap" ]] && xmodmap ~/.Xmodmap
run blueman-applet
run ssh-agent -D -a /run/user/1000/ssh-agent.socket

# XFCE base install
run /usr/libexec/at-spi-bus-launcher --launch-immediately
run /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
run system-config-printer-applet
run /usr/bin/gnome-keyring-daemon --start --components=ssh

if [ -f "$(which xfce4-notifyd)" ]; then
  run xfce4-notifyd
else
  run dunst
fi


